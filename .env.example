# Copy to .env and fill in. docker-compose picks this file up automatically.

# Pick one. With neither set the app still runs, using an offline keyword classifier.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# auto = Anthropic if its key is set, else OpenAI, else offline
AI_PROVIDER=auto
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_MODEL=gpt-4o-mini

# Used to sign in to the support dashboard (http://localhost:8080/admin)
ADMIN_API_KEY=change-me-admin-key
